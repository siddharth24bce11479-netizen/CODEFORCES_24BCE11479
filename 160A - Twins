import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int[] a = new int[n];
        int sum = 0;

        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
            sum += a[i];
        }

        Arrays.sort(a);

        int me = 0, count = 0;

        for (int i = n - 1; i >= 0; i--) {
            me += a[i];
            count++;

            if (me > sum - me)
                break;
        }

        System.out.println(count);
    }
}
