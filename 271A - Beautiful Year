import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int y = sc.nextInt();

        while (true) {
            y++;

            String s = "" + y;
            boolean ok = true;

            for (int i = 0; i < s.length(); i++) {
                for (int j = i + 1; j < s.length(); j++) {
                    if (s.charAt(i) == s.charAt(j))
                        ok = false;
                }
            }

            if (ok) {
                System.out.println(y);
                break;
            }
        }
    }
}
