import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int k = sc.nextInt();
        int r = sc.nextInt();

        for (int i = 1; i <= 10; i++) {
            if ((k * i) % 10 == 0 || (k * i) % 10 == r) {
                System.out.println(i);
                break;
            }
        }
    }
}
